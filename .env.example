# Contact form email delivery (https://resend.com)
RESEND_API_KEY=

# Where enquiries are delivered (defaults to carshiftos@gmail.com)
CONTACT_TO_EMAIL=carshiftos@gmail.com

# Optional. Set only after verifying your domain in Resend, e.g.
# "Car ShiftOS <hello@carshiftos.co.ke>". Enables the confirmation email to visitors.
# Leave unset to use Resend's test sender (delivers only to your own Resend account email).
CONTACT_FROM_EMAIL=
